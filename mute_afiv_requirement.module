<?php
// web/modules/custom/mute_afiv_requirement/mute_afiv_requirement.module

/**
 * Implements hook_requirements_alter().
 */
function mute_afiv_requirement_requirements_alter(array &$requirements, $phase) : void {

  //dpm('mute afiv');
  if ($phase !== 'runtime') {
    return;
  }

  // Remove the "Supported image file formats" row entirely.
  if (isset($requirements['gd_formats'])) {
    unset($requirements['gd_formats']);
  }

  // Fallback: if any requirement mentions AVIF, downgrade to OK and shorten.
  foreach ($requirements as $key => &$item) {
    $value = ($item['value'] ?? '') . ' ' . ($item['description'] ?? '') . ' ' . ($item['title'] ?? '');
    if (stripos($value, 'avif') !== FALSE) {
      $item['severity'] = REQUIREMENT_OK;
      $item['description'] = '';
    }
  }
}
